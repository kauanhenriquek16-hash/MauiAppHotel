<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource PrimaryDark}">

    <VerticalStackLayout
        VerticalOptions="CenterAndExpand"
        Padding="30">

        <Label Text="MAUI"
               FontSize="42"
               FontAttributes="Bold"
               TextColor="{StaticResource Tertiary}"
               HorizontalOptions="Center" />

        <Label Text="HOTEL"
               FontSize="16"
               TextColor="{StaticResource Tertiary}"
               HorizontalOptions="Center"
               CharacterSpacing="8"
               Margin="0,0,0,40" />

        <Frame BackgroundColor="#1e1207"
               BorderColor="{StaticResource Tertiary}"
               CornerRadius="12"
               Padding="24">
            <VerticalStackLayout Spacing="20">

                <Label Text="SOBRE O APLICATIVO"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Tertiary}"
                       CharacterSpacing="3"
                       HorizontalOptions="Center" />

                <VerticalStackLayout Spacing="4">
                    <Label Text="Desenvolvedor"
                           FontSize="11"
                           TextColor="{StaticResource Gray500}" />
                    <Label Text="Kauan"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Ano de Desenvolvimento"
                           FontSize="11"
                           TextColor="{StaticResource Gray500}" />
                    <Label Text="2025"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Versão"
                           FontSize="11"
                           TextColor="{StaticResource Gray500}" />
                    <Label Text="1.0.0"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Descrição"
                           FontSize="11"
                           TextColor="{StaticResource Gray500}" />
                    <Label Text="Aplicativo para cálculo e contratação de hospedagem em hotel."
                           FontSize="14"
                           TextColor="White"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Frame>
    </VerticalStackLayout>
</ContentPage>